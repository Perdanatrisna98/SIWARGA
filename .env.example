# Salin file ini menjadi .env.local lalu sesuaikan nilainya
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siwarga_v2

# Buat secret acak, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti-dengan-secret-acak-yang-panjang

# Set true bila aplikasi diakses melalui HTTPS
AUTH_COOKIE_SECURE=false
